<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="600" height="750">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0d13" />
      <stop offset="50%" stop-color="#121520" />
      <stop offset="100%" stop-color="#08090d" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#22283a" stroke-width="0.8" opacity="0.6" />
      <circle cx="0" cy="0" r="1.5" fill="#e11d48" opacity="0.4" />
    </pattern>
    <linearGradient id="redAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e11d48" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#be123c" stop-opacity="0.2" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="600" height="750" fill="url(#bg)" />
  <rect width="600" height="750" fill="url(#grid)" />

  <!-- Technical border frame -->
  <rect x="16" y="16" width="568" height="718" fill="none" stroke="#282e42" stroke-width="1.2" stroke-dasharray="8 4" opacity="0.7"/>

  <!-- Corner Brackets -->
  <path d="M 28 44 L 28 28 L 44 28" fill="none" stroke="#e11d48" stroke-width="2.5" />
  <path d="M 556 28 L 572 28 L 572 44" fill="none" stroke="#e11d48" stroke-width="2.5" />
  <path d="M 28 706 L 28 722 L 44 722" fill="none" stroke="#e11d48" stroke-width="2.5" />
  <path d="M 556 722 L 572 722 L 572 706" fill="none" stroke="#e11d48" stroke-width="2.5" />

  <!-- Center Engineering Crosshair -->
  <circle cx="300" cy="375" r="54" fill="none" stroke="#e11d48" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.4" />
  <circle cx="300" cy="375" r="32" fill="#141724" stroke="#e11d48" stroke-width="1.8" />
  <line x1="280" y1="375" x2="320" y2="375" stroke="#f43f5e" stroke-width="2" />
  <line x1="300" y1="355" x2="300" y2="395" stroke="#f43f5e" stroke-width="2" />

  <!-- Top technical telemetry badge -->
  <rect x="36" y="36" width="180" height="24" rx="3" fill="#191d2c" stroke="#2c3349" stroke-width="1" />
  <text x="46" y="52" fill="#e11d48" font-family="monospace" font-size="11" font-weight="bold">SPEC // MEMBER-05</text>
  <text x="450" y="52" fill="#64748b" font-family="monospace" font-size="11" text-anchor="end">ASSET // PLACEHOLDER</text>

  <!-- Title & Subtitle -->
  <text x="300" y="450" fill="#f8fafc" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="700" text-anchor="middle" letter-spacing="1.5">
    TEAM MEMBER 05
  </text>
  <text x="300" y="477" fill="#94a3b8" font-family="monospace" font-size="12" text-anchor="middle">
    Member Photo Placeholder (600x750)
  </text>

  <!-- Bottom Coordinates -->
  <line x1="36" y1="710" x2="564" y2="710" stroke="#232738" stroke-width="1" />
  <text x="36" y="726" fill="#475569" font-family="monospace" font-size="10">SYS: MEC-AUTO-2026</text>
  <text x="564" y="726" fill="#475569" font-family="monospace" font-size="10" text-anchor="end">ASPECT: 600x750</text>
</svg>