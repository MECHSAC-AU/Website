# ========================================================
# MECHSAC Environment Configuration Example
# Copy this file to .env.local and fill in your actual credentials.
# Never commit real secrets to GitHub!
# ========================================================

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# GitHub OAuth Credentials (configured in Supabase Dashboard > Authentication > Providers > GitHub)
# Callback URL in GitHub OAuth App: https://your-project.supabase.co/auth/v1/callback

# Resend API Key (for automated approval/rejection emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=MECHSAC <onboarding@resend.dev>

# Authorized Admin Email (used for initial admin allowlist check)
AUTHORIZED_ADMIN_EMAIL=mechsac.au@gmail.com
